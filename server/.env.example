# server/.env.example — mọi biến cấu hình của máy chủ game (giá trị mẫu, KHÔNG phải bí mật thật).
# Lần chạy đầu `npm start` tự tạo server/.env với các bí mật ngẫu nhiên (file đó bị .gitignore, không commit).
# Thứ tự ưu tiên: biến môi trường > server/.env > mặc định.

# ---- Bí mật (tự sinh lần đầu; production bắt buộc có) ----
JWT_PRIVATE_KEY=        # khoá Ed25519 PKCS#8 DER dạng base64 (ký access token EdDSA)
JWT_KID=                # mã khoá (đổi khi xoay khoá)
TICKET_HMAC_KEY=        # 32 byte base64url, ký vé vào /play
ADMIN_TOKEN=            # mã trang quản trị (Authorization: Bearer ...), ≥ 24 ký tự
DB_PASSWORD=            # mật khẩu Postgres trong docker compose

# ---- Tuỳ chọn (để trống = tắt) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TURNSTILE_SECRET=
TUNNEL_TOKEN=           # Cloudflare named tunnel (profile "tunnel" của docker compose)

# ---- Mạng ----
NODE_ENV=development    # development | production | test
IN_DOCKER=false         # true trong container: nghe 0.0.0.0 (compose chỉ publish 127.0.0.1)
GAME_PORT=9100
GAME_HOST=              # mặc định 127.0.0.1 (0.0.0.0 khi IN_DOCKER)
ADMIN_PORT=9101
ADMIN_HOST=             # mặc định 127.0.0.1 (0.0.0.0 khi IN_DOCKER; compose publish 127.0.0.1:9101)
PUBLIC_WS_URL=ws://127.0.0.1:9100/play       # địa chỉ /v1/join trả cho trình duyệt (wss://<tên miền>/play khi có tunnel)
PUBLIC_HTTP_URL=http://127.0.0.1:9100
ALLOWED_ORIGINS=https://tungtase04539.github.io,http://localhost:*,http://127.0.0.1:*
ALLOW_NO_ORIGIN=true    # cho bot/curl (không gửi Origin)
TRUST_PROXY=none        # cloudflare = tin header CF-Connecting-IP (chỉ khi cổng game CHỈ tới được qua tunnel)
TRANSPORT=auto          # auto | uws | ws

# ---- Cơ sở dữ liệu ----
DB_URL=                 # postgres://hp:<DB_PASSWORD>@db:5432/hp — có DB_URL thì dùng Postgres
DB_DRIVER=              # pg | pglite (mặc định: pg nếu có DB_URL, ngược lại pglite)
PGLITE_DIR=             # mặc định server/data/pglite; "memory" = trong RAM (mất khi tắt)
DB_POOL_MAX=10

# ---- Trò chơi ----
CAPACITY=1200
INVITE_REQUIRED=true
DAY_EPOCH=1767225600000 # mốc ngày/đêm chung (ms) — giữ cố định để giờ trong game không nhảy
DAY_LENGTH=1440
TICK_HZ=20
SNAP_HZ=10
HTTP_BODY_LIMIT=16384

# ---- Nhật ký ----
LOG_LEVEL=info          # debug | info | warn | error | silent
LOG_FORMAT=json         # json | pretty
DATA_DIR=               # mặc định server/data
