{
  "name": "hp-world-server",
  "version": "0.1.0",
  "private": true,
  "description": "Hai Phong 3D multiplayer game server (closed test)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.js",
