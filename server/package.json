    "bots": "node bots/run.mjs"
  },
  "dependencies": {
    "jose": "6.2.12",
    "pg": "8.23.1",
    "uWebSockets.js": "https://github.com/uNetworking/uWebSockets.js/archive/refs/tags/v20.71.0.tar.gz",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10"
  }
}
